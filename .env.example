# 本機開發用範本。複製成 .env 後填值；.env 不可 commit。
# Cloud Run 上：一般設定用環境變數，兩個 SECRET 由 Secret Manager 掛載。

# 服務對外網址（Cloud Run 網址，結尾不要加 /）
PUBLIC_BASE_URL=https://ga4-mcp-xxxxxxxx-de.a.run.app

# Google 登入用 OAuth 用戶端（Web 應用程式類型）
GOOGLE_OAUTH_CLIENT_ID=
# Cloud Run 上由 Secret Manager「ga4-mcp-google-client-secret」提供
GOOGLE_OAUTH_CLIENT_SECRET=

# 管理頁 cookie 簽章用，至少 32 字元亂數
# Cloud Run 上由 Secret Manager「ga4-mcp-session-secret」提供
SESSION_SECRET=

# 管理員 email（逗號分隔，不分大小寫）：可進管理頁、可用連接器，不能從管理頁移除
# 一般使用者在管理頁新增，存在 Firestore 的 allowed_users
ALLOWED_EMAILS=you@example.com

# 管理頁可加入的使用者網域（逗號分隔）；省略時沿用管理員 email 的網域
# ALLOWED_DOMAINS=example.com

# 允許查詢的 GA4 資源 ID（逗號分隔）；第一個是預設
ALLOWED_PROPERTY_IDS=YOUR_GA4_PROPERTY_ID

# 允許的 Claude 連接器回呼網址（逗號分隔）
ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# 單次查詢最長天數
MAX_RANGE_DAYS=400

PORT=8080
